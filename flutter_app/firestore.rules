rules_version = '2';

// Security rules for PMA — Packing & Monitoring App.
//
// PMA uses the project's `(default)` Firestore database.
//
// `request.auth` is populated by BOTH the Firebase Auth SDK (mobile) and the
// REST id-token (Windows), so a single signed-in check covers every platform.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{id}           { allow read, write: if signedIn(); }
    match /products/{id}        { allow read, write: if signedIn(); }
    match /machines/{id}        { allow read, write: if signedIn(); }
    match /packing_entries/{id} { allow read, write: if signedIn(); }
    match /temp_humidity/{id}   { allow read, write: if signedIn(); }
    match /devices/{id}         { allow read, write: if signedIn(); }
    match /th_thresholds/{id}   { allow read, write: if signedIn(); }
    match /global_settings/{id} { allow read, write: if signedIn(); }

    // Automation alerts: phones raise them, the pushAlert Cloud Function
    // sends them to managers over FCM. Alerts are never deleted from a phone.
    match /alerts/{id} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    // Deny anything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
